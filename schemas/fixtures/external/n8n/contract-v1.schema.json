{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crm.silmer.invalid/schemas/integrations/n8n/v1",
  "title": "CRM Silmer n8n integration contract v1",
  "$defs": {
    "commonEnvelope": {
      "type": "object",
      "required": ["schema_version"],
      "properties": {
        "schema_version": { "const": "1.0" }
      }
    },
    "automaticEnvelope": {
      "allOf": [
        { "$ref": "#/$defs/commonEnvelope" },
        {
          "type": "object",
          "required": ["automation_epoch"],
          "properties": {
            "automation_epoch": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "channel": { "enum": ["whatsapp", "site_chat"] },
    "siteContact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "phone"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 24 }
      }
    },
    "briefingPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artwork_locations": { "type": ["array", "null"] },
        "artwork_status": { "type": ["string", "null"] },
        "artwork_technique": { "type": ["string", "null"] },
        "audiences": { "type": ["string", "null"] },
        "briefing_status": { "type": ["string", "null"] },
        "city_or_postal_code": { "type": ["string", "null"] },
        "collar": { "type": ["string", "null"] },
        "colors": { "type": ["array", "null"] },
        "customer_name": { "type": ["string", "null"] },
        "customizations": { "type": ["array", "null"] },
        "delivery_address": { "type": ["string", "null"] },
        "delivery_mode": { "type": ["string", "null"] },
        "fabrics": { "type": ["array", "null"] },
        "needed_by": { "type": ["string", "null"] },
        "next_required_field": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "numbers": { "type": ["array", "null"] },
        "order_name": { "type": ["string", "null"] },
        "pickup_location": { "type": ["string", "null"] },
        "product_model": { "type": ["string", "null"] },
        "product_type": { "type": ["string", "null"] },
        "purchase_profile": { "type": ["string", "null"] },
        "purpose": { "type": ["string", "null"] },
        "quantity": { "type": ["integer", "null"], "minimum": 1 },
        "segment": { "type": ["string", "null"] },
        "sizes": { "type": ["array", "null"] },
        "sponsors": { "type": ["array", "null"] }
      }
    },
    "turn": {
      "description": "AGENTE-OBS-01: optional turn telemetry on message.send.requested and handoff.requested. Codes, counts and times only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ficha_filled", "ficha_total"],
      "properties": {
        "asked_field": {
          "type": ["string", "null"],
          "pattern": "^[a-z_]{1,48}$"
        },
        "answer_status": {
          "enum": [
            "answered",
            "unclear",
            "undecided",
            "question",
            "deferred",
            "other",
            "none",
            null
          ]
        },
        "ficha_filled": { "type": "integer", "minimum": 0, "maximum": 64 },
        "ficha_total": { "type": "integer", "minimum": 0, "maximum": 64 },
        "trigger": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "model": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9._-]{1,64}$"
        },
        "latency_ms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 600000
        },
        "media_kind": { "enum": ["text", "image", "audio", "sticker", null] }
      }
    },
    "transcript": {
      "description": "INBOX-AUDIO-TRANSCRIPT-01: the transcript of an inbound audio, on message.transcribed.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "text"],
          "properties": {
            "status": { "const": "ok" },
            "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "code"],
          "properties": {
            "status": { "const": "failed" },
            "code": {
              "enum": [
                "TRANSCRIPTION_FAILED",
                "TRANSCRIPTION_EMPTY",
                "AUDIO_TOO_LARGE"
              ]
            }
          }
        }
      ]
    },
    "deliveryFailure": {
      "description": "INBOX-DELIVERY-02: failure on message.failed and message.send.unknown. A code outside ^[A-Z0-9_]{1,64}$ is stored as the generic code.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" }
      }
    },
    "openOrder": {
      "description": "ADR 014: true asks the CRM to create or reuse the pending order after the event commits. Only on message.send.requested and handoff.requested.",
      "type": "boolean"
    },
    "orderOpening": {
      "description": "ADR 014: the `order` field of the event response when open_order is true. A failure never fails the event.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["opened", "id", "subject_id", "created"],
          "properties": {
            "opened": { "const": true },
            "id": { "$ref": "#/$defs/opaqueId" },
            "subject_id": { "$ref": "#/$defs/opaqueId" },
            "created": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["opened", "error"],
          "properties": {
            "opened": { "const": false },
            "error": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
          }
        }
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "instance",
        "accepted",
        "error",
        "request_id"
      ],
      "properties": {
        "type": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "detail": { "type": "string", "minLength": 1 },
        "instance": { "type": "string", "minLength": 1 },
        "accepted": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
          }
        },
        "request_id": { "$ref": "#/$defs/opaqueId" },
        "correlation_id": { "$ref": "#/$defs/opaqueId" }
      }
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "authentication",
    "requiredHeaders",
    "errorMediaType",
    "channels",
    "activeChannels",
    "endpoints",
    "eventTypes",
    "openOrderEvents",
    "briefingPatchFields",
    "deliveryStatusOrder",
    "security"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "authentication": {
      "type": "object",
      "required": ["scheme", "serviceActor", "rotation"],
      "properties": {
        "scheme": { "const": "Basic" },
        "serviceActor": { "const": "AUTOMATION_EXECUTOR" },
        "rotation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "requiredHeaders": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 6,
      "items": { "type": "string" }
    },
    "errorMediaType": { "const": "application/problem+json" },
    "channels": {
      "type": "array",
      "const": ["whatsapp", "site_chat"]
    },
    "activeChannels": {
      "type": "array",
      "const": ["site_chat"]
    },
    "endpoints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["method", "path", "requestFixture"],
        "properties": {
          "method": { "const": "POST" },
          "path": { "type": "string", "minLength": 1 },
          "requestFixture": { "type": "string", "pattern": "\\.json$" },
          "responseFixture": { "type": "string", "pattern": "\\.json$" }
        },
        "additionalProperties": false
      }
    },
    "eventTypes": {
      "type": "array",
      "contains": { "const": "message.send.requested" }
    },
    "handoffReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z_]{1,64}$" }
    },
    "openOrderEvents": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["message.send.requested", "handoff.requested"] }
    },
    "briefingPatchFields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "deliveryStatusOrder": {
      "type": "array",
      "const": ["sent", "delivered", "read"]
    },
    "security": {
      "type": "object",
      "additionalProperties": { "const": true }
    }
  },
  "additionalProperties": false
}
